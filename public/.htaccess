# Serveur Apache (Infomaniak): les fichiers qui décrivent la version de l'app ne doivent pas rester en cache,
# sinon une mise à jour n'arrive pas sur les téléphones. Les fichiers dans assets/ ont un nom unique par version.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest|workbox-.*\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2?|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
